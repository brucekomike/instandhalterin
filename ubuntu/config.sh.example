# config.sh.example
#
# Example configuration for the ubuntu/ helper scripts.
#
# The active file is config.sh, which bin/configstrap.sh creates from this
# file when config.sh is missing:
#     bin/configstrap.sh            # generate config.sh from this example
#
# Edit the values below, then regenerate config.sh.
# NOTE: this file is committed to git; config.sh is NOT (see .gitignore).


APT_PROXY="http://192.168.1.2:3142"

DEFAULT_PROXY=

# --- Public SSH keys (~/.ssh/authorized_keys) ---------------------------------
# Multi-line public key lines. addkey.sh appends SSHKEYS to
# $HOME/.ssh/authorized_keys. Replace the placeholder keys with your own.
# single key per line
SSHKEYS="
"

# --- Maintenance user (rscripts/om-user.bash) ---------------------------------
# Single sudo user that om-user.bash creates on every target host. When
# MAINT_SSHKEYS is empty the payload falls back to SSHKEYS above, so the
# maintenance account simply gets the same keys as the operator account.
MAINT_USER="maintainer"

# Multi-line public key lines for $MAINT_USER/.ssh/authorized_keys. Leave empty
# to reuse SSHKEYS. single key per line
MAINT_SSHKEYS="
"
